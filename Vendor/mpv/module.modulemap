// libmpv C API 的 Swift 导入模块。
// 头文件来自 Homebrew(链接方案 A:开发期直接用 Homebrew 绝对路径),
// 因此这里的绝对路径仅本机可用,
// 与 OTHER_LDFLAGS 中的 /opt/homebrew/lib/libmpv.dylib 保持同一方案。
//
// 注意:正确路径是 <mpv/...>,不是网上旧教程的 <libmpv/...>
// (本机不存在 /opt/homebrew/include/libmpv/)。
module mpv {
    header "/opt/homebrew/include/mpv/client.h"
    header "/opt/homebrew/include/mpv/render.h"
    header "/opt/homebrew/include/mpv/render_gl.h"
    export *
}
