diff --git a/video/out/gpu_next/ra.c b/video/out/gpu_next/ra.c
index c8411dc..1fed410 100644
--- a/video/out/gpu_next/ra.c
+++ b/video/out/gpu_next/ra.c
@@ -14,6 +14,21 @@
 #include "video/img_format.h"              // for mp_imgfmt_comp_desc, mp_im...
