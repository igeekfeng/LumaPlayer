# danmu_api 配置
#
# 只列本部署实际用到的变量;完整清单见仓库 `config/.env.example`
# (https://github.com/huangxd-/danmu_api 的 config/.env.example)。
#
# 改这个文件不需要重启容器 —— danmu_api 会 watch config/.env 并热重载。
# 优先级:系统环境变量 > 这个文件。

# ==================== 基础 ====================

# 接口令牌。danmu_api 的鉴权是「令牌写在 URL 路径里」(/{TOKEN}/api/v2/...),
# 不是弹弹play 的签名头。
#
# LumaPlayer 目前还连不上自定义地址(见 docs/DANMU_API_FEASIBILITY.md §3),
# 等接入改造落地后,设置页里要填的地址就是:
#     http://127.0.0.1:9321            ← 保持默认值时可以不带令牌
#     http://127.0.0.1:9321/<TOKEN>    ← 改了令牌就必须带
#
# 只绑定 127.0.0.1 时用默认值即可;要给局域网里别的设备(电视 / FengMi)用,
# 改成随机串,并把端口映射从 127.0.0.1 改成 0.0.0.0。
TOKEN=87654321

# 监听端口,容器内固定 9321,端口映射在 docker-compose.yml 里改
DANMU_API_PORT=9321

# 管理界面 / 系统管理接口的令牌。留空 = 不启用系统管理。
# 需要看 UI 后台(日志、请求记录、本地弹幕上传)时自己设一个,
# 然后访问 http://127.0.0.1:9321/<ADMIN_TOKEN>
# ADMIN_TOKEN=

# ==================== 限流 ====================

# 1 分钟内同一 IP 对 /api/v2/comment 的最大请求数,0 = 不限流。
#
# 默认 3 次/分钟会误伤:LumaPlayer 匹配一集要走 match → bangumi → comment
# 三步,连看几集就撞限流(弹幕缓存命中时不计数,但首次拉取一定计数)。
# 自建服务没有上游滥用压力,直接关掉。
RATE_LIMIT_MAX_REQUESTS=0

# ==================== 采集源 ====================

# 源查询顺序。默认只有 douban,360,renren,hanjutv 四个。
# 要让腾讯 / 优酷 / 爱奇艺 / 芒果 / B 站等平台参与匹配,必须手动加进来。
#
# 代价:源越多,一次 match 的上游请求越多、耗时越长。
# 巴哈姆特(bahamut)需要代理才能连,本机没有 → 不加;
# 要加的话先配 PROXY_URL=bahamut@https://<反代地址>。
SOURCE_ORDER=douban,360,renren,hanjutv,tencent,youku,iqiyi,imgo,bilibili,migu,sohu,leshi,xigua,maiduidui,aiyifan,hongguo

# 弹幕输出格式。LumaPlayer 只解析 json,别改。
DANMU_OUTPUT_FORMAT=json

# ==================== 缓存 ====================

# 搜索结果 / 弹幕的内存缓存时长(分钟)。0 = 不缓存。
SEARCH_CACHE_MINUTES=3
COMMENT_CACHE_MINUTES=5

# 弹幕少于这个条数时无视缓存时间、强制重新拉取。0 = 关闭。
COMMENT_CACHE_MIN_COUNT=100

# Bangumi Data 辅助匹配:补全番剧元数据、提升检索速度与匹配精度。
# 依赖挂载 .cache 目录持久化(否则每次重启重新下载约 4 MB)。
USE_BANGUMI_DATA=true
BANGUMI_DATA_CACHE_DAYS=7

# ==================== 日志 ====================

# error / warn / info。排障用 info,日常用 warn。
LOG_LEVEL=info
