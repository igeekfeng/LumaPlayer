+#if HAVE_VIDEOTOOLBOX_GL
+// VideoToolbox zero-copy: wrap the decoder's IOSurface planes as GL rectangle
+// textures instead of copying every frame back to RAM (hwdec=videotoolbox-copy)
+// and re-uploading it. Same mechanism as the legacy renderer's hwdec_mac_gl.c.
+#define GL_SILENCE_DEPRECATION // OpenGL is the only API this backend has
+#include <CoreVideo/CoreVideo.h>
+#include <IOSurface/IOSurface.h>
+#include <OpenGL/OpenGL.h>
+#include <OpenGL/CGLIOSurface.h>
+#include <OpenGL/gl3.h>
+#include <libplacebo/opengl.h>
+#include "video/mp_image_pool.h"           // for mp_image_hw_download
+#endif
 
 /**
  * @brief Private state for the libplacebo rendering abstraction.
@@ -285,6 +300,118 @@ static int plane_data_from_imgfmt(struct pl_plane_data out_data[4],
     return desc.num_planes;
 }
 
+#if HAVE_VIDEOTOOLBOX_GL
+/**
+ * Maps a hwdec=videotoolbox frame without a CPU round trip: every IOSurface
+ * plane is bound to a GL_TEXTURE_RECTANGLE via CGLTexImageIOSurface2D (as the
+ * legacy renderer's hwdec_mac_gl.c does) and then blitted on the GPU into a
+ * regular 2D texture owned by libplacebo.
+ *
+ * The extra GPU blit is deliberate: libplacebo's GL backend emits invalid GLSL
+ * for sampler2DRect (textureSize(sampler2DRect, int)), so the rectangle
+ * texture cannot be sampled directly. Since the plane is copied, the
+ * rectangle texture is released right away and nothing ties the IOSurface's
+ * lifetime to the pl_frame; ra_pl_cleanup_frame() needs no special case.
+ * @return 1 on success, 0 if the sub-format is not handled here (caller falls
+ *         back to a CPU download), -1 on hard failure.
+ */
+static int map_videotoolbox_frame(struct ra_next *ra, struct pl_frame *out_frame,
+                                  const struct mp_image *img)
+{
+    CGLContextObj cgl = CGLGetCurrentContext();
+    if (!cgl || !pl_opengl_get(ra->gpu))
+        return 0;
+
+    CVPixelBufferRef pbuf = (CVPixelBufferRef)img->planes[3];
+    IOSurfaceRef surface = pbuf ? CVPixelBufferGetIOSurface(pbuf) : NULL;
+    if (!surface)
+        return 0;
+
+    struct pl_plane_data data[4] = {0};
+    int planes = plane_data_from_imgfmt(data, &out_frame->repr.bits,
+                                        img->params.hw_subfmt, false);
+    if (!planes || planes != (int)IOSurfaceGetPlaneCount(surface))
+        return 0;
+
+    // Only plain 8/16-bit UNORM planes with 1 or 2 components (nv12, p010,
+    // p016, ...). Anything else goes through the CPU download fallback.
+    int comps[4], depth[4];
+    for (int n = 0; n < planes; n++) {
+        comps[n] = 0;
+        depth[n] = data[n].component_size[0];
+        for (int c = 0; c < 4 && data[n].component_size[c]; c++) {
+            if (data[n].component_size[c] != depth[n] || data[n].component_pad[c])
+                return 0;
+            comps[n]++;
+        }
+        if ((depth[n] != 8 && depth[n] != 16) || comps[n] < 1 || comps[n] > 2 ||
+            data[n].type != PL_FMT_UNORM ||
+            data[n].pixel_stride * 8 != comps[n] * depth[n])
+            return 0;
+    }
+
+    out_frame->num_planes = 0;
+    for (int n = 0; n < planes; n++) {
+        bool wide = depth[n] == 16;
+        GLint ifmt = comps[n] == 1 ? (wide ? GL_R16 : GL_R8) : (wide ? GL_RG16 : GL_RG8);
+        int w = (int)IOSurfaceGetWidthOfPlane(surface, n);
+        int h = (int)IOSurfaceGetHeightOfPlane(surface, n);
+
+        pl_fmt fmt = pl_find_fmt(ra->gpu, PL_FMT_UNORM, comps[n], depth[n], depth[n],
+                                 PL_FMT_CAP_SAMPLEABLE | PL_FMT_CAP_LINEAR |
+                                 PL_FMT_CAP_BLITTABLE);
+        pl_tex dst = fmt ? pl_tex_create(ra->gpu, pl_tex_params(
+            .w = w,
+            .h = h,
+            .format = fmt,
+            .sampleable = true,
+            .blit_dst = true,
+        )) : NULL;
+
+        GLuint gl_tex = 0;
+        glGenTextures(1, &gl_tex);
+        glBindTexture(GL_TEXTURE_RECTANGLE, gl_tex);
+        CGLError err = CGLTexImageIOSurface2D(cgl, GL_TEXTURE_RECTANGLE, ifmt, w, h,
+                                              comps[n] == 1 ? GL_RED : GL_RG,
+                                              wide ? GL_UNSIGNED_SHORT : GL_UNSIGNED_BYTE,
+                                              surface, n);
+        glBindTexture(GL_TEXTURE_RECTANGLE, 0);
+        pl_tex src = NULL;
+        if (err == kCGLNoError) {
+            src = pl_opengl_wrap(ra->gpu, pl_opengl_wrap_params(
+                .texture = gl_tex,
+                .width = w,
+                .height = h,
+                .target = GL_TEXTURE_RECTANGLE,
+                .iformat = ifmt,
+            ));
+        }
+        bool ok = dst && src && src->params.blit_src;
+        if (ok)
+            pl_tex_blit(ra->gpu, pl_tex_blit_params(.src = src, .dst = dst));
+        // GL orders the blit before the delete; the source can go right away.
+        pl_tex_destroy(ra->gpu, &src);
+        glDeleteTextures(1, &gl_tex);
+
+        if (!ok) {
+            mp_msg(ra->log, MSGL_ERR, "Failed to map IOSurface plane %d (%s)\n",
+                   n, err == kCGLNoError ? "texture setup" : CGLErrorString(err));
+            pl_tex_destroy(ra->gpu, &dst);
+            ra_pl_cleanup_frame(ra, out_frame);
+            return -1;
+        }
+
+        struct pl_plane *plane = &out_frame->planes[n];
+        plane->texture = dst;
+        plane->components = comps[n];
+        for (int c = 0; c < comps[n]; c++)
+            plane->component_mapping[c] = data[n].component_map[c];
+        out_frame->num_planes = n + 1;
+    }
+    return 1;
+}
+#endif
